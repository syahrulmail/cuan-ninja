---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';

const cuan_db = env.cuan_db;

if (!cuan_db) {
  return new Response(
    "D1 Binding 'cuan_db' tidak ditemukan! Silakan cek Dashboard Cloudflare -> Settings -> Functions.",
    { status: 500 }
  );
}

const { results } = await cuan_db
  .prepare('SELECT * FROM products ORDER BY created_at DESC')
  .all();

const products = results as Array<{
  id: string;
  slug: string;
  name: string;
  description: string | null;
  affiliate_url: string;
  image_url: string | null;
  category: string | null;
  video_url: string | null;
  images: string | null;
  click_count: number;
}>;

function parseLabels(raw: string | null): string[] {
  if (!raw) return [];
  const trimmed = raw.trim();
  if (trimmed.startsWith('[')) {
    try {
      const parsed = JSON.parse(trimmed);
      return Array.isArray(parsed) ? parsed.map(String) : [trimmed];
    } catch {
      return [trimmed];
    }
  }
  return trimmed
    .split(',')
    .map((label) => label.trim())
    .filter(Boolean);
}

function parseImages(raw: string | null): string[] {
  if (!raw) return [];
  const trimmed = raw.trim();
  if (trimmed.startsWith('[')) {
    try {
      const parsed = JSON.parse(trimmed);
      return Array.isArray(parsed) ? parsed.map(String) : [];
    } catch {
      return [];
    }
  }
  return [];
}

const labeledProducts = products.map((product) => ({
  ...product,
  labels: parseLabels(product.category),
  imageList: parseImages(product.images)
}));

const allLabels = [...new Set(labeledProducts.flatMap((p) => p.labels))].sort((a, b) =>
  a.localeCompare(b)
);

const totalClicks = products.reduce((sum, p) => sum + (p.click_count || 0), 0);

const modalProducts = labeledProducts.map((p) => ({
  slug: p.slug,
  name: p.name,
  description: p.description || '',
  video: p.video_url || '',
  images: p.imageList,
  image: p.image_url || '',
  affiliate: p.affiliate_url,
  labels: p.labels,
  clicks: p.click_count
}));
const modalDataJson = JSON.stringify(modalProducts).replace(/</g, '\\u003c');
---

<Layout title="Cuan.ninja | Kurasi Produk Digital">
  <div class="relative min-h-screen flex flex-col overflow-x-clip">
    <!-- Navbar -->
    <header class="sticky top-0 z-40 border-b border-border/60 bg-bg-primary/80 backdrop-blur-xl">
      <nav class="mx-auto max-w-7xl px-5 sm:px-8 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 shrink-0">
          <span class="grid place-items-center h-8 w-8 rounded-lg bg-gradient-to-br from-accent to-accent-2 shadow-[0_0_18px_rgba(99,102,241,0.45)]">
            <svg class="h-4.5 w-4.5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 8-8M21 7v4h-4" />
            </svg>
          </span>
          <span class="font-display text-lg font-bold tracking-tight">
            Cuan<span class="text-gradient">.ninja</span>
          </span>
        </a>
        <div class="flex items-center gap-1">
          <a href="/" class="nav-link">Katalog</a>
          <a href="/#how" class="nav-link hidden sm:inline-flex">Cara Kerja</a>
          <a href="/#catalog" class="btn-primary ml-2 !py-2 !px-4 text-xs">
            Jelajahi
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <!-- Hero -->
      <section class="relative">
        <div
          class="absolute inset-0 bg-grid [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)]"
          aria-hidden="true"
        ></div>
        <div class="absolute top-[-120px] left-1/2 -translate-x-1/2 glow-orb h-[360px] w-[640px] bg-accent/20 animate-float-slow" aria-hidden="true"></div>
        <div class="absolute top-[40px] left-[10%] glow-orb h-[200px] w-[200px] bg-gold/10 animate-float-slow" style="animation-delay:-3s" aria-hidden="true"></div>
        <div class="absolute top-[80px] right-[8%] glow-orb h-[220px] w-[220px] bg-accent-2/15 animate-float-slow" style="animation-delay:-6s" aria-hidden="true"></div>

        <div class="relative mx-auto max-w-7xl px-5 sm:px-8 pt-20 pb-14 text-center">
          <div class="reveal is-visible">
            <span class="badge !py-1.5 !px-4 !text-xs !text-accent !border-accent/40 !bg-accent/10 mb-6">
