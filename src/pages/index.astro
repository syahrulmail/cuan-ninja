          <div class="flex gap-2 mt-2.5 overflow-x-auto no-scrollbar pb-0.5" role="group" aria-label="Filter label">
            <button class="chip !px-3 !py-1.5 !text-xs chip-active" data-label="all">Semua</button>
            {allLabels.map((label) => (
              <button class="chip !px-3 !py-1.5 !text-xs shrink-0" data-label={label}>
                {label}
