                type="button"
                id="sticky-clear"
                aria-label="Hapus pencarian"
                class="absolute right-2 top-1/2 -translate-y-1/2 hidden h-5 w-5 items-center justify-center rounded-full bg-white/10 text-text-secondary hover:bg-white/20 hover:text-text-primary transition-colors"
