            ))}
          </div>
        </div>
      </div>

      <!-- Catalog -->
      <section id="catalog" class="mx-auto max-w-7xl px-5 sm:px-8 pt-6">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
