        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="card card-hover p-8 text-center reveal">
            <div class="mx-auto mb-5 h-14 w-14 grid place-items-center rounded-2xl bg-gradient-to-br from-accent to-accent-2 shadow-[0_0_24px_rgba(99,102,241,0.35)]">
